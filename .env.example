# Choose a random URL-safe password. Never commit the real .env.
POSTGRES_PASSWORD=
APP_ORIGIN=http://127.0.0.1:18780
COOKIE_SECURE=false
MARKET_PORT=18780
SYNC_CURSOR_SECRET=
# Leave false until desired price formulas and raw-detail retention are verified.
HISTORY_COMPACTION_ENABLED=false
RAW_LISTING_DAYS=7
DETAILED_STATISTICS_DAYS=90
# HTTPS deployment must use COOKIE_SECURE=true and the exact HTTPS APP_ORIGIN.

# Optional attributed community beta metadata; never a source of market prices.
ITEM_COMMUNITY_FALLBACK_ENABLED=false

# Public ingress overlay requires a private token, generated by scripts/init-env.py.
INGRESS_PROXY_TOKEN=
# Keep fail-closed at the actual Traefik IP. Do not use the rootless gateway
# unless an administrator has installed and verified the source-only firewall rule.
MARKET_TRANSPORT_PEER=10.0.4.3
