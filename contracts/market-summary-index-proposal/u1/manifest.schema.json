{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.twich.gg/market-summary-index/experimental-u1",
  "title": "Inactive U1 partition foundation; not a production protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experimental",
    "market",
    "issuer_id",
    "pricing_algorithm",
    "history_basis",
    "source_kind",
    "confidence_ceiling",
    "can_satisfy_local_competition",
    "source_watermark",
    "generated_at",
    "identity_basis",
    "columns",
    "states",
    "confidence_states",
    "generation_id",
    "source_observation",
    "format",
    "schema_version",
    "coverage",
    "record_count",
    "partitioning",
    "partitions"
  ],
  "properties": {
    "experimental": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/experimental"
    },
    "market": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/market"
    },
    "issuer_id": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/issuer_id"
    },
    "pricing_algorithm": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/pricing_algorithm"
    },
    "history_basis": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/history_basis"
    },
    "source_kind": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/source_kind"
    },
    "confidence_ceiling": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/confidence_ceiling"
    },
    "can_satisfy_local_competition": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/can_satisfy_local_competition"
    },
    "source_watermark": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/source_watermark"
    },
    "generated_at": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/generated_at"
    },
    "identity_basis": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/identity_basis"
    },
    "columns": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/columns"
    },
    "states": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/states"
    },
    "confidence_states": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/confidence_states"
    },
    "generation_id": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/generation_id"
    },
    "source_observation": {
      "$ref": "https://contracts.twich.gg/market-summary-index/proposal-v1#/properties/source_observation"
    },
    "format": {
      "const": "twichui-market-summary-partitions-u1"
    },
    "schema_version": {
      "const": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "complete",
        "missing",
        "detailed_history"
      ],
      "properties": {
        "type": {
          "const": "all_retained_exact_identity_summaries"
        },
        "complete": {
          "type": "boolean"
        },
        "missing": {
          "const": "unavailable"
        },
        "detailed_history": {
          "const": "independent"
        }
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150000
    },
    "partitioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "buckets",
        "max_partition_bytes"
      ],
      "properties": {
        "algorithm": {
          "const": "item_id_modulo"
        },
        "buckets": {
          "const": 64
        },
        "max_partition_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 262144
        }
      }
    },
    "partitions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bucket",
          "file",
          "bytes",
          "record_count",
          "sha256"
        ],
        "properties": {
          "bucket": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "file": {
            "type": "string",
            "pattern": "^[0-9]{2}-[0-9a-f]{64}\\.json$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 2,
            "maximum": 262144
          },
          "record_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
