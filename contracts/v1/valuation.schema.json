{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:twichui-market:valuation:v1",
  "title": "Compact asking-price valuation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recent_price", "lowest_buyout", "market_value", "historical_value", "supply", "priced_supply", "listing_count", "coverage_days", "market_coverage_days", "synthetic"],
  "$defs": {
    "copper": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,18})$", "format": "copper-i64", "description": "Integer copper as a string, 0 through 9223372036854775807; null means unavailable."}
  },
  "properties": {
    "recent_price": {"$ref": "#/$defs/copper"},
    "lowest_buyout": {"$ref": "#/$defs/copper"},
    "market_value": {"$ref": "#/$defs/copper"},
    "historical_value": {"$ref": "#/$defs/copper"},
    "supply": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "priced_supply": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "listing_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "coverage_days": {"type": "integer", "minimum": 0, "maximum": 61},
    "market_coverage_days": {"type": "integer", "minimum": 0, "maximum": 15},
    "synthetic": {"type": "boolean"}
  }
}
