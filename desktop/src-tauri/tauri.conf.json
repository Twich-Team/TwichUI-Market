{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwichUI Market Companion",
  "version": "2.0.0-beta.4",
  "identifier": "team.twich.market",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TwichUI Market Companion",
        "width": 520,
        "height": 710,
        "minWidth": 440,
        "minHeight": 560,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Private market data companion",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "allowDowngrades": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
