{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwichUI Market Companion",
  "version": "0.1.0",
  "identifier": "team.twich.market",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title": "TwichUI Market Companion", "width": 880, "height": 760, "minWidth": 600, "minHeight": 600}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"}
  },
  "bundle": {"active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"], "shortDescription": "Private market data companion", "category": "Utility"}
}
